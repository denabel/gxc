Package: gxc
Type: Package
Title: Easy Access to Earth Observation Data
Version: 1.0.0
Authors@R: c(
    person("Dennis", "Abel", , "dennis.abel@gesis.org", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-6220-2511")),
